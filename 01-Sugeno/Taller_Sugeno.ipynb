        "ax1.scatter(x_ini, [calcular_fitness(x) for x in x_ini], color='crimson', s=70, label='Gen 0 (Inicial)', zorder=4)\n",
        "ax1.scatter(x_final, fit_final, color='forestgreen', marker='^', s=100, label=f'Gen {N_GENERACIONES} (Final)', zorder=5)\n",
